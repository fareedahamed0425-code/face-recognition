# =================================================================
# Face ID + Blockchain Verification Pipeline Configuration
# =================================================================

# 1. Reverse Image Search Configuration
# Obtain your free/tier API key from https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_key_here

# Optional: RapidAPI Visual Search Key
RAPIDAPI_KEY=your_rapidapi_key_here

# 2. Blockchain & Web3 Configuration
# Choose network: sepolia | base_sepolia | polygon_amoy | arbitrum_sepolia | local
BLOCKCHAIN_NETWORK=sepolia

# EVM RPC Provider URL (e.g. Infura, Alchemy, Ankr, or public RPC)
WEB3_RPC_URL=https://rpc.sepolia.org

# Deployer / Signer Private Key (without 0x prefix or with 0x prefix)
# Used to sign on-chain verification transactions
PRIVATE_KEY=your_testnet_private_key_here

# Deployed FaceVerificationRegistry Smart Contract Address
# Leave blank to run in automatic testnet proof mode, or specify deployed contract:
CONTRACT_ADDRESS=0x742d35Cc6634C0532925a3b844Bc454e4438f44e

# 3. Server Configuration
HOST=0.0.0.0
PORT=8000
